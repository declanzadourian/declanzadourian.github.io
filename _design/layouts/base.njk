<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- set isHome = page.url == "/" %}
<title>{% if isHome %}{{ site.title }}{% else %}{{ displayTitle }} – {{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta property="og:title" content="{% if isHome %}{{ site.title }}{% else %}{{ displayTitle }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="{% if section %}article{% else %}website{% endif %}">
{%- if collections.placeholders and collections.placeholders.length %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body>
{{ content | safe }}
</body>
</html>
